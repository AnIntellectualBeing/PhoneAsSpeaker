<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="24dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/Body"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Muted"
            android:layout_marginTop="2dp"
            android:text="@string/tagline" />

        <!-- Party card -->
        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/status_text"
                style="@style/Body"
                android:layout_marginBottom="14dp"
                android:text="@string/status_idle" />

            <Button
                android:id="@+id/start_button"
                style="@style/BigButton"
                android:text="@string/start_party" />

            <TextView
                android:id="@+id/error_text"
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:textColor="@color/danger"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/party_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/qr_image"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:background="@drawable/qr_frame"
                    android:contentDescription="QR code with the party address"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/url_text"
                    style="@style/Body"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:textIsSelectable="true"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/share_button"
                        style="@style/SmallButton"
                        android:text="@string/share_link" />

                    <Button
                        android:id="@+id/hotspot_button"
                        style="@style/SmallButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/hotspot_settings" />
                </LinearLayout>

                <TextView
                    android:id="@+id/other_urls"
                    style="@style/Muted"
                    android:gravity="center"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    style="@style/Muted"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/scan_to_join" />

                <TextView
                    android:id="@+id/listeners_text"
                    style="@style/Body"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/listeners_detail"
                    style="@style/Muted"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:visibility="gone" />

                <com.syncspeaker.app.LevelMeterView
                    android:id="@+id/level_meter"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/level_hint"
                    style="@style/Muted"
                    android:layout_marginTop="6dp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- Settings card -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Heading"
                android:text="@string/settings" />

            <Switch
                android:id="@+id/play_locally_switch"
                style="@style/SettingSwitch"
                android:text="@string/play_locally" />

            <Switch
                android:id="@+id/alarm_switch"
                style="@style/SettingSwitch"
                android:text="@string/alarm_stream" />

            <TextView
                style="@style/Muted"
                android:textSize="12sp"
                android:text="@string/alarm_stream_hint" />

            <TextView
                android:id="@+id/delay_label"
                style="@style/Body"
                android:layout_marginTop="14dp" />

            <SeekBar
                android:id="@+id/delay_seek"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <Switch
                android:id="@+id/keep_screen_switch"
                style="@style/SettingSwitch"
                android:text="@string/keep_screen_on" />
        </LinearLayout>

        <!-- Tips card -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Heading"
                android:text="@string/tips_title" />

            <TextView
                style="@style/Muted"
                android:text="@string/tips_body" />
        </LinearLayout>

        <Button
            android:id="@+id/capture_test_button"
            style="@style/SecondaryButton"
            android:layout_marginTop="18dp"
            android:text="@string/capture_test" />

        <TextView
            style="@style/Muted"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textSize="12sp"
            android:text="@string/footer" />
    </LinearLayout>
</ScrollView>
